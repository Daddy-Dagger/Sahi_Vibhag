// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Complaint {
  id                    String   @id @default(uuid())
  title                 String
  description           String
  translatedDescription String?
  department            String
  status                String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED, REJECTED
  priority              String   @default("MEDIUM")  // LOW, MEDIUM, HIGH, URGENT
  category              String
  summary               String
  missingInformation    Json     // array of strings (e.g. ["Specific landmark of pothole"])
  evidenceChecklist     Json     // array of objects: { name: string, required: boolean, submitted: boolean }
  citizenName           String?
  citizenPhone          String?
  location              String?
  latitude              Float?
  longitude             Float?
  accuracy              Float?
  formattedAddress      String?
  landmark              String?
  city                  String?
  state                 String?
  pincode               String?
  confidence            Float    @default(1.0)
  audioUrl              String?
  officerNotes          String?
  timeline              Json     // array of objects: { status: string, timestamp: string, note: string }
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

